    {
      "parameters": {
        "jsCode": "const d=$('Claim next content').first().json;\nif(!d.id||!d.claim_id) return [];\nconst allowed=new Set([\"busy\", \"content_limit\", \"expanded_size_limit\", \"extraction_failed\", \"extraction_timeout\", \"file_size_limit\", \"incomplete_body\", \"invalid_csv\", \"invalid_pdf\", \"invalid_xls\", \"invalid_xlsx\", \"macros_not_supported\", \"no_content\", \"not_found\", \"page_limit\", \"sheet_dimensions_limit\", \"sheet_limit\", \"unauthorized\", \"unsupported_kind\"]);\nconst candidate=$input.first().json.error;\nconst errorCode=typeof candidate==='string'&&allowed.has(candidate)?candidate:'extraction_failed';\nreturn [{json:{p_document_id:d.id,p_claim_id:d.claim_id,p_source_etag:d.source_etag,p_status:'failed',p_metadata:{error_code:errorCode},p_execution_id:String($execution.id)}}];"
