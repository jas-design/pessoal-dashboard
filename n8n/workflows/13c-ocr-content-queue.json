    {
      "parameters": {
        "jsCode": "return $input.all().map((item,index)=>{\n const p=$('Prepare text and provenance').itemMatching(index).json;\n if(item.json.id!==p.document.external_file_id||item.json.eTag!==p.document.source_etag||item.json.size!==p.document.file_size) throw new Error('Source changed during extraction');\n return {json:p,pairedItem:{item:index}};\n});"
      },
