---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Login | Hub Pessoal">
  <form class="login-form" id="login-form">
    <div class="login-form__header">
      <div class="sidebar__logo">⚡</div>
      <h1>Entrar no Hub</h1>
      <p>Acesse seu dashboard executivo.</p>
    </div>

    <label>
      E-mail
      <input id="email" type="email" placeholder="seu@email.com" required />
    </label>

    <label>
      Senha
      <input id="password" type="password" placeholder="Sua senha" required />
    </label>

    <button class="button-primary" type="submit"> Entrar </button>

    <p id="login-error" class="login-form__error"></p>
  </form>

  <script>
    import supabase from "../lib/supabase/client";

    const form = document.querySelector<HTMLFormElement>("#login-form");

    const emailInput = document.querySelector<HTMLInputElement>("#email");

    const passwordInput = document.querySelector<HTMLInputElement>("#password");

    const errorMessage = document.querySelector<HTMLElement>("#login-error");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!emailInput || !passwordInput || !errorMessage) {
        return;
      }

      const { data, error } = await supabase.auth.signInWithPassword({
        email: emailInput.value,
        password: passwordInput.value,
      });

      if (error) {
        errorMessage.textContent = "E-mail ou senha inválidos.";
        return;
      }

      if (!data.session) {
        errorMessage.textContent = "A sessão não foi criada.";
        return;
      }

      window.location.href = "/dashboard";
    });
  </script>
</AuthLayout>
