---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { getAutomationLogs } from "../services/automation/logs";

const logs = await getAutomationLogs();
---

<DashboardLayout
  title="Logs e Histórico"
  subtitle="Acompanhe erros, execuções e eventos do sistema."
>
  <section class="page-card">
    <div class="page-card__header">
      <div>
        <h2>Histórico de eventos</h2>
        <p>Logs consolidados das integrações e automações.</p>
      </div>
    </div>

    <div class="table">
      <div class="table__row table__row--head">
        <span>Workflow</span>
        <span>Fonte</span>
        <span>Status</span>
        <span>Data</span>
      </div>

      {
        logs.map((log) => (
          <div class="table__row">
            <span>{log.workflow_name}</span>
            <span>{log.source}</span>
            <span
              class={log.status === "error" ? "status-error" : "status-success"}
            >
              {log.status}
            </span>
            <span>{new Date(log.created_at).toLocaleString("pt-BR")}</span>
          </div>
        ))
      }
    </div>
  </section>
</DashboardLayout>
