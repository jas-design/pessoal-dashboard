---
import DocumentsBreadcrumb from "../../components/documents/DocumentsBreadcrumb.astro";
import DocumentsFilters from "../../components/documents/DocumentsFilters.astro";
import DocumentsFolderTree from "../../components/documents/DocumentsFolderTree.astro";
import DocumentsSourceTabs from "../../components/documents/DocumentsSourceTabs.astro";
import DocumentsTable from "../../components/documents/DocumentsTable.astro";
import DocumentsToolbar from "../../components/documents/DocumentsToolbar.astro";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import "../../styles/pages/_documents.scss";
---

<DashboardLayout
  title="Documentos"
  subtitle="Gerencie e acesse todos os seus arquivos em um só lugar."
>
  <DocumentsToolbar />
  <DocumentsSourceTabs />
  <DocumentsFilters />

  <section class="documents-manager">
    <DocumentsFolderTree />

    <main class="documents-browser">
      <DocumentsBreadcrumb />
      <DocumentsTable />
    </main>
  </section>
</DashboardLayout>

<script>
  import { loadDocumentsFileManager } from "../../scripts/documents/file-manager";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadDocumentsFileManager, { once: true });
  } else {
    loadDocumentsFileManager();
  }
</script>
