---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DocumentsList from "../../components/documents/DocumentsList.astro";
import "../../styles/pages/documentos.scss";
---

<DashboardLayout
  title="Documentos"
  subtitle="Visualize arquivos privados do Supabase e arquivos sincronizados do Google Drive."
>
  <section class="page-card">
    <div class="page-card__header">
      <div>
        <h2>Catálogo de documentos</h2>

        <p>Arquivos registrados no sistema, independentemente da origem.</p>
      </div>

      <a href="/documentos/upload" class="button-primary"> Enviar arquivos </a>
    </div>

    <DocumentsList />
  </section>
</DashboardLayout>
