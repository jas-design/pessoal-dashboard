---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import FinancialUploadForm from "../../components/documents/FinancialUploadForm.astro";
---

<DashboardLayout
  title="Upload financeiro"
  subtitle="Envie documentos financeiros privados para processamento."
>
  <section class="page-card">
    <div class="page-card__header">
      <div>
        <h2>Enviar arquivos privados</h2>

        <p>
          Os documentos serão armazenados em um bucket privado e registrados no
          catálogo do sistema.
        </p>
      </div>

      <a href="/documentos" class="button-small"> Voltar aos documentos </a>
    </div>

    <FinancialUploadForm />
  </section>
</DashboardLayout>
