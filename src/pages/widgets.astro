---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { getAllDashboardWidgets } from "../services/dashboard/widgets";

const widgets = await getAllDashboardWidgets();
---

<DashboardLayout
  title="Widgets"
  subtitle="Gerencie os cards e módulos exibidos no dashboard."
>
  <section class="page-card">
    <div class="page-card__header">
      <div>
        <h2>Widgets do Dashboard</h2>
        <p>Controle quais widgets aparecem no painel principal.</p>
      </div>
    </div>

    <div class="table">
      <div class="table__row table__row--head table__row--5">
        <span>Widget</span>
        <span>Tipo</span>
        <span>Fonte</span>
        <span>Posição</span>
        <span>Status</span>
      </div>

      {
        widgets.map((widget) => (
          <div class="table__row table__row--5">
            <span>{widget.title}</span>
            <span>{widget.widget_type}</span>
            <span>{widget.data_source}</span>
            <span>{widget.position}</span>
            <span class={widget.is_active ? "status-success" : "status-error"}>
              {widget.is_active ? "Ativo" : "Inativo"}
            </span>
          </div>
        ))
      }
    </div>
  </section>
</DashboardLayout>
