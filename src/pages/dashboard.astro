---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import ActivityFeed from "../components/dashboard/ActivityFeed.astro";
import AutomationChart from "../components/dashboard/AutomationChart.astro";
import IntegrationCard from "../components/dashboard/IntegrationCard.astro";
import MetricCard from "../components/dashboard/MetricCard.astro";

import { getRecentActivities } from "../services/activity/activities";
import { getAutomationDailyStats } from "../services/dashboard/charts";
import { getDashboardMetrics } from "../services/dashboard/metrics";
import { getIntegrations } from "../services/integrations/integrations";

const [metrics, chartStats, activities, integrations] = await Promise.all([
  getDashboardMetrics(),
  getAutomationDailyStats(),
  getRecentActivities(),
  getIntegrations(),
]);
---

<DashboardLayout>
  <section class="metrics-grid">
    {
      metrics.map((metric) => (
        <MetricCard
          title={metric.metric_label}
          value={metric.metric_value}
          variation={metric.variation}
          comparison={metric.comparison_label}
          icon={metric.icon}
        />
      ))
    }
  </section>

  <section class="dashboard-grid">
    <AutomationChart stats={chartStats} />
    <ActivityFeed activities={activities} />
  </section>

  <section class="section-heading">
    <h2>Status das Integrações SaaS</h2>
    <p>Conexões de API ativas e monitoramento de canais externos</p>
  </section>

  <section class="integrations-grid">
    {
      integrations.map((integration) => (
        <IntegrationCard
          name={integration.name}
          tag={integration.api_version}
          status={
            integration.status === "connected" ? "Conectado" : "Desconectado"
          }
          stats={[
            { label: "Tipo:", value: integration.type },
            { label: "Status:", value: integration.status },
          ]}
        />
      ))
    }
  </section>
</DashboardLayout>
