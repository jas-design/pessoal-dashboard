---
import CashFlowChart from "../components/financial/CashFlowChart.astro";
import FinancialAccountsSection from "../components/financial/FinancialAccountsSection.astro";
import FinancialIndicatorsSection from "../components/financial/FinancialIndicatorsSection.astro";
import FinancialMetricCard from "../components/financial/FinancialMetricCard.astro";
import MonthlyFinancialSummary from "../components/financial/MonthlyFinancialSummary.astro";
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { financialMetricCards } from "../services/financial/dashboard-data";
import "../styles/pages/dashboard.scss";

const loadingSparklinePath = "M 0 36 L 240 36";
---

<DashboardLayout
  title="Dashboard Financeiro"
  subtitle="Resumo essencial dos indicadores que importam para sua leitura financeira."
  showFinancialPeriod
>
  <section class="metrics-grid" id="dashboard-metrics-grid" aria-live="polite">
    {
      financialMetricCards.map((metric, index) => (
        <FinancialMetricCard
          metricKey={metric.key}
          title={metric.label}
          value="Carregando..."
          icon={metric.icon}
          accent={metric.accent}
          accentSoft={metric.accentSoft}
          accentGlow={metric.accentGlow}
          sparklinePath={loadingSparklinePath}
          index={index}
        />
      ))
    }
  </section>

  <div class="financial-overview-grid">
    <CashFlowChart />
    <MonthlyFinancialSummary />
  </div>

  <div class="financial-summary-grid">
    <FinancialAccountsSection />
    <FinancialIndicatorsSection />
  </div>
</DashboardLayout>

<script>
  import { loadFinancialDashboard } from "../services/financial/dashboard-data";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadFinancialDashboard, { once: true });
  } else {
    loadFinancialDashboard();
  }
</script>
