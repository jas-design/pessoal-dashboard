---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import WidgetEngine from "../components/widgets/WidgetEngine.astro";

import { getDashboardWidgets } from "../services/dashboard/widgets";
import { loadWidgetData } from "../components/widgets/WidgetLoader";

const widgets = await getDashboardWidgets();
const widgetData = await loadWidgetData();
---

<DashboardLayout>
  <section class="metrics-grid">
    <WidgetEngine widgets={widgets} data={widgetData} type="metric" />
  </section>

  <section class="dashboard-grid">
    <WidgetEngine widgets={widgets} data={widgetData} type="chart" />

    <WidgetEngine widgets={widgets} data={widgetData} type="activity" />
  </section>

  <section class="section-heading">
    <h2>Status das Integrações SaaS</h2>
    <p>Conexões de API ativas e monitoramento de canais externos</p>
  </section>

  <WidgetEngine widgets={widgets} data={widgetData} type="integration" />
</DashboardLayout>
