---
import DashboardLayout from "../layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Google Drive"
  subtitle="Arquivos enviados, organizados e monitorados."
>
  <section class="page-card">
    <div class="page-card__header">
      <div>
        <h2>Arquivos recentes</h2>
        <p>Uploads e movimentações feitas pelas automações.</p>
      </div>
    </div>

    <div class="table">
      <div class="table__row table__row--head">
        <span>Arquivo</span>
        <span>Pasta</span>
        <span>Status</span>
        <span>Data</span>
      </div>

      <div class="table__row">
        <span>Faturamento_Q2_Final.xlsx</span>
        <span>Financeiro</span>
        <span class="status-success">Enviado</span>
        <span>Hoje</span>
      </div>

      <div class="table__row">
        <span>Contrato_Cliente.pdf</span>
        <span>Contratos</span>
        <span class="status-success">Organizado</span>
        <span>Ontem</span>
      </div>
    </div>
  </section>
</DashboardLayout>
