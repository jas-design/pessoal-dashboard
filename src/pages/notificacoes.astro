---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import "../styles/pages/notificacoes.scss";
---

<DashboardLayout
  title="Notificações"
  subtitle="Acompanhe alertas do sistema, automações e integrações."
>
  <section class="page-card notifications-page" data-notifications-page aria-busy="true">
    <div class="page-card__header">
      <div>
        <h2>Central de notificações</h2>
        <p>Alertas recentes vindos do Supabase, n8n e integrações.</p>
      </div>
    </div>

    <div class="notifications-state" data-notifications-loading role="status">
      <span class="notifications-state__loader" aria-hidden="true"></span>
      <div>
        <h3>Carregando notificações</h3>
        <p>Aguarde enquanto confirmamos sua sessão.</p>
      </div>
    </div>

    <div class="notifications-state" data-notifications-unauthenticated hidden>
      <div>
        <h3>Sessão não autenticada</h3>
        <p>Sua sessão pode ter expirado. Entre novamente para consultar as notificações.</p>
        <a class="button-small" href="/login">Ir para o login</a>
      </div>
    </div>

    <div class="notifications-state notifications-state--error" data-notifications-error role="alert" hidden>
      <div>
        <h3>Não foi possível carregar as notificações</h3>
        <p data-notifications-error-message>Tente novamente em alguns instantes.</p>
        <button class="button-small" type="button" data-notifications-retry>
          Tentar novamente
        </button>
      </div>
    </div>

    <div class="empty-state" data-notifications-empty hidden>
      <div>
        <h3>Nenhuma notificação encontrada</h3>
        <p>Quando houver novos alertas, eles aparecerão aqui.</p>
      </div>
    </div>

    <div class="table notifications-table" data-notifications-table role="table" hidden>
      <div class="table__row table__row--head table__row--5" role="row">
        <span role="columnheader">Título</span>
        <span role="columnheader">Tipo</span>
        <span role="columnheader">Status</span>
        <span role="columnheader">Data</span>
        <span role="columnheader">Ação</span>
      </div>
      <div data-notifications-items role="rowgroup"></div>
    </div>

    <p class="notifications-feedback" data-notifications-feedback role="status" aria-live="polite"></p>
  </section>
</DashboardLayout>
