---
import DashboardLayout from "../layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Documentos"
  subtitle="Controle de arquivos, relatórios e documentos processados."
>
  <section class="page-card">
    <div class="page-card__header">
      <div>
        <h2>Documentos processados</h2>
        <p>Central de documentos capturados via Gmail, Drive ou upload.</p>
      </div>
    </div>

    <div class="empty-state">
      <h3>Nenhum documento selecionado</h3>
      <p>Quando um documento for processado, ele aparecerá aqui.</p>
    </div>
  </section>
</DashboardLayout>
