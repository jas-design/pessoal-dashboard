---
import DashboardLayout from "../layouts/DashboardLayout.astro";

import { getApiConnections } from "../services/integrations/api-connection";
import { getSystemHealth } from "../services/system/health";
import { getWebhooks } from "../services/system/webhook";

const apiConnections = await getApiConnections();
const systemHealth = await getSystemHealth();
const webhooks = await getWebhooks();
---

<DashboardLayout
  title="Sistema"
  subtitle="Monitore conexões, webhooks e saúde da infraestrutura."
>
  <section class="system-grid">
    <div class="page-card">
      <div class="page-card__header">
        <div>
          <h2>Saúde do Sistema</h2>
          <p>Status dos principais serviços conectados.</p>
        </div>
      </div>

      <div class="table">
        <div class="table__row table__row--head">
          <span>Serviço</span>
          <span>Status</span>
          <span>Resposta</span>
          <span>Uptime</span>
        </div>

        {
          systemHealth.map((item) => (
            <div class="table__row">
              <span>{item.service_name}</span>
              <span
                class={
                  item.status === "online" ? "status-success" : "status-error"
                }
              >
                {item.status}
              </span>
              <span>{item.response_time_ms}ms</span>
              <span>{item.uptime_percentage}%</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="page-card">
      <div class="page-card__header">
        <div>
          <h2>Conexões de API</h2>
          <p>Integrações externas registradas no sistema.</p>
        </div>
      </div>

      <div class="table">
        <div class="table__row table__row--head">
          <span>Provider</span>
          <span>Status</span>
          <span>Tipo</span>
          <span>Última Sync</span>
        </div>

        {
          apiConnections.map((connection) => (
            <div class="table__row">
              <span>{connection.provider}</span>
              <span
                class={
                  connection.status === "connected"
                    ? "status-success"
                    : "status-error"
                }
              >
                {connection.status}
              </span>
              <span>{connection.connection_type}</span>
              <span>
                {connection.last_sync_at
                  ? new Date(connection.last_sync_at).toLocaleString("pt-BR")
                  : "Nunca"}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-card">
    <div class="page-card__header">
      <div>
        <h2>Webhooks</h2>
        <p>Endpoints preparados para receber eventos do n8n e integrações.</p>
      </div>
    </div>

    <div class="table">
      <div class="table__row table__row--head">
        <span>Nome</span>
        <span>Fonte</span>
        <span>Status</span>
        <span>Endpoint</span>
      </div>

      {
        webhooks.map((webhook) => (
          <div class="table__row">
            <span>{webhook.name}</span>
            <span>{webhook.source}</span>
            <span
              class={
                webhook.status === "active" ? "status-success" : "status-error"
              }
            >
              {webhook.status}
            </span>
            <span>{webhook.endpoint_url}</span>
          </div>
        ))
      }
    </div>
  </section>
</DashboardLayout>
