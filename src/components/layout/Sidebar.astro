---
const icons = {
  grid: "[ ]",
  money: "[$]",
  bank: "[$]",
  report: "[=]",
  file: "[#]",
  settings: "[=]",
  bell: "[!]",
} as const;

type IconName = keyof typeof icons;

interface MenuItem {
  label: string;
  href: string;
  icon: IconName;
  badge: string | null;
}

const menuItems: MenuItem[] = [
  { label: "Dashboard", href: "/dashboard", icon: "grid", badge: null },
  { label: "Financeiro", href: "/financeiro", icon: "money", badge: null },
  { label: "Bancos e Contas", href: "/bancos-contas", icon: "bank", badge: null },
  { label: "Relatorios", href: "/relatorios", icon: "report", badge: null },
  { label: "Documentos", href: "/documentos", icon: "file", badge: null },
  {
    label: "Configuracoes",
    href: "/configuracoes",
    icon: "settings",
    badge: null,
  },
  { label: "Notificacoes", href: "/notificacoes", icon: "bell", badge: null },
];

const currentPath = Astro.url.pathname;
---

<aside class="sidebar">
  <div class="sidebar__brand">
    <div class="sidebar__logo">HP</div>

    <div>
      <strong>Hub Pessoal</strong>
      <span>EXECUTIVO V1.0</span>
    </div>
  </div>

  <nav class="sidebar__nav">
    {
      menuItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "sidebar__link",
            currentPath === item.href && "is-active",
          ]}
        >
          <span class="sidebar__icon">{icons[item.icon]}</span>
          <span>{item.label}</span>

          {item.badge && <span class="sidebar__badge">{item.badge}</span>}
        </a>
      ))
    }
  </nav>

  <div class="sidebar__footer">
    <div class="sidebar__user" aria-live="polite">
      <div class="sidebar__avatar" data-sidebar-user-avatar aria-hidden="true">…</div>

      <div>
        <strong data-sidebar-user-name>Verificando sessão</strong>
        <span data-sidebar-user-status>Aguarde</span>
      </div>
    </div>
  </div>
</aside>

<script>
  import { initializeSidebarSession } from "../../scripts/layout/sidebar";

  initializeSidebarSession();
</script>
