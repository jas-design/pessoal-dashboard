---
import FinancialPeriodSelect from "../financial/FinancialPeriodSelect.astro";
import { getUnreadNotificationsCount } from "../../services/notifications/notifications";
import "../../styles/layouts/header.scss";

const {
  title = "Olá, Andres 👋",
  subtitle = "Aqui está o resumo das suas operações de hoje.",
  showFinancialPeriod = false,
} = Astro.props;

const unreadCount = await getUnreadNotificationsCount();
---

<header class="header">
  <div class="header__intro">
    <h1>{title}</h1>
    <p>{subtitle}</p>
  </div>

  <div class="header__actions">
    {showFinancialPeriod && <FinancialPeriodSelect />}

    <button
      class="header__theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Alternar tema claro e escuro"
    >
      <span class="header__theme-icon header__theme-icon--sun" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
      </span>

      <span class="header__theme-icon header__theme-icon--moon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M21 12.8A8.6 8.6 0 1 1 11.2 3a6.8 6.8 0 0 0 9.8 9.8Z"></path>
        </svg>
      </span>
    </button>

    <a href="/notificacoes" class="header__notification">
      🔔
      {unreadCount > 0 && <span>{unreadCount}</span>}
    </a>

    <button class="header__logout" id="logout-button"> Sair </button>
  </div>
</header>

<script>
  import { signOut } from "../../services/auth/auth";

  const logoutButton = document.querySelector("#logout-button");
  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const storageKey = "dashboard-theme";

  function getCurrentTheme() {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  }

  function updateThemeToggleLabel() {
    if (!themeToggle) {
      return;
    }

    const nextTheme = getCurrentTheme() === "dark" ? "claro" : "escuro";
    themeToggle.setAttribute("aria-label", `Alternar para tema ${nextTheme}`);
  }

  logoutButton?.addEventListener("click", async () => {
    await signOut();
    window.location.href = "/login";
  });

  themeToggle?.addEventListener("click", () => {
    const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";

    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem(storageKey, nextTheme);
    updateThemeToggleLabel();
  });

  updateThemeToggleLabel();
</script>
