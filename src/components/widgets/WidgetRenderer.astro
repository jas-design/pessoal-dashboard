---
import MetricCard from "../MetricCard.astro";

const { widget, metrics = [] } = Astro.props;

const metric = metrics.find((item) => item.metric_key === widget.widget_key);
---

{
  widget.widget_type === "metric" && metric && (
    <MetricCard
      title={metric.metric_label}
      value={metric.metric_value}
      variation={metric.variation}
      comparison={metric.comparison_label}
      icon={metric.icon}
    />
  )
}
