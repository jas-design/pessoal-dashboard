---
import MetricWidget from "./renderers/MetricWidget.astro";
import ChartWidget from "./renderers/ChartWidget.astro";
import ActivityWidget from "./renderers/ActivityWidget.astro";
import IntegrationWidget from "./renderers/IntegrationWidget.astro";
import UnsupportedWidget from "./renderers/UnsupportedWidget.astro";

const { widget, data } = Astro.props;
---

{
  widget.widget_type === "metric" && (
    <MetricWidget widget={widget} data={data} />
  )
}

{widget.widget_type === "chart" && <ChartWidget widget={widget} data={data} />}

{
  widget.widget_type === "activity" && (
    <ActivityWidget widget={widget} data={data} />
  )
}

{
  widget.widget_type === "integration" && (
    <IntegrationWidget widget={widget} data={data} />
  )
}

{
  !["metric", "chart", "activity", "integration"].includes(
    widget.widget_type,
  ) && <UnsupportedWidget widget={widget} />
}
