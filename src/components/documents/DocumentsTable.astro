<div class="documents-browser-state" data-documents-loading role="status">
  Carregando documentos...
</div>

<div class="documents-error" data-documents-error role="alert" hidden>
  <span data-documents-error-message></span>
  <button class="button-small" type="button" data-documents-retry>
    Tentar novamente
  </button>
</div>

<div class="empty-state documents-empty" data-documents-empty hidden>
  <div>
    <h3 data-documents-empty-title>Nenhum documento encontrado</h3>
    <p data-documents-empty-message>
      Os arquivos enviados pelo dashboard ou sincronizados futuramente aparecerão aqui.
    </p>
  </div>
</div>

<div class="documents-table-wrap" data-documents-table hidden>
  <table class="documents-file-table">
    <thead>
      <tr>
        <th scope="col">
          <input
            type="checkbox"
            aria-label="Selecionar todos os documentos"
            data-documents-select-all
          />
        </th>
        <th scope="col">Nome</th>
        <th scope="col">Origem</th>
        <th scope="col">Tipo</th>
        <th scope="col">Modificado em</th>
        <th scope="col">Tamanho</th>
        <th scope="col">Status</th>
        <th scope="col">Ações</th>
      </tr>
    </thead>

    <tbody data-documents-table-body></tbody>
  </table>
</div>

<nav
  class="documents-pagination"
  aria-label="Paginação de documentos"
  data-documents-pagination
  hidden
>
  <p data-documents-page-summary aria-live="polite"></p>

  <div>
    <button class="button-small" type="button" data-documents-page-previous>
      Anterior
    </button>
    <span data-documents-page-label></span>
    <button class="button-small" type="button" data-documents-page-next>
      Próxima
    </button>
  </div>
</nav>

<dialog class="documents-details-dialog" data-documents-details-dialog>
  <div class="documents-details-dialog__header">
    <h3>Detalhes do documento</h3>
    <button type="button" data-documents-details-close aria-label="Fechar detalhes">
      ×
    </button>
  </div>

  <dl data-documents-details-list></dl>
</dialog>
