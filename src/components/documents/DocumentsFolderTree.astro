<aside class="documents-folder-panel">
  <div class="documents-panel-header">
    <span>Pastas</span>
    <small>OneDrive</small>
  </div>

  <nav class="documents-folder-tree" aria-label="Pastas do OneDrive" data-documents-folder-tree>
    <p class="documents-folder-state" data-documents-folders-loading role="status">
      Carregando pastas...
    </p>

    <div
      class="documents-folder-state documents-folder-state--error"
      data-documents-folders-error
      role="alert"
      hidden
    >
      <span data-documents-folders-error-message></span>
      <button class="button-small" type="button" data-documents-folders-retry>
        Tentar novamente
      </button>
    </div>

    <p class="documents-folder-state" data-documents-folders-empty hidden>
      Nenhuma pasta do OneDrive encontrada.
    </p>

    <ul data-documents-folder-root hidden></ul>
  </nav>
</aside>
