---
// TEMPORARY MOCK DATA: visual-only folder tree until OneDrive/document_folders exist.
// Do not insert these folders into Supabase.
---

<aside class="documents-folder-panel">
  <div class="documents-panel-header">
    <span>Pastas</span>
    <small>Visual temporário</small>
  </div>

  <nav class="documents-folder-tree" aria-label="Pastas de documentos">
    <ul>
      <li>
        <button type="button" data-folder-path="Todas as pastas">
          <span aria-hidden="true">&rsaquo;</span>
          Todas as pastas
        </button>

        <ul>
          <li>
            <button type="button" data-folder-path="OneDrive">
              <span aria-hidden="true">&rsaquo;</span>
              OneDrive
            </button>

            <ul>
              <li>
                <button type="button" data-folder-path="OneDrive > Empresa A">
                  <span aria-hidden="true">&rsaquo;</span>
                  Empresa A
                </button>

                <ul>
                  <li>
                    <button type="button" data-folder-path="OneDrive > Empresa A > Empresa">
                      <span aria-hidden="true">&rsaquo;</span>
                      Empresa
                    </button>

                    <ul>
                      <li>
                        <button
                          type="button"
                          data-folder-path="OneDrive > Empresa A > Empresa > Financeiro"
                        >
                          <span aria-hidden="true">&rsaquo;</span>
                          Financeiro
                        </button>

                        <ul>
                          <li>
                            <button
                              type="button"
                              data-folder-path="OneDrive > Empresa A > Empresa > Financeiro > 2026"
                            >
                              <span aria-hidden="true">&rsaquo;</span>
                              2026
                            </button>

                            <ul>
                              <li>
                                <button
                                  type="button"
                                  data-folder-path="OneDrive > Empresa A > Empresa > Financeiro > 2026 > Agosto"
                                >
                                  <span aria-hidden="true">&rsaquo;</span>
                                  Agosto
                                </button>
                              </li>

                              <li>
                                <button
                                  type="button"
                                  data-folder-path="OneDrive > Empresa A > Empresa > Financeiro > 2026 > Julho"
                                >
                                  <span aria-hidden="true">&rsaquo;</span>
                                  Julho
                                </button>
                              </li>

                              <li>
                                <button
                                  type="button"
                                  data-folder-path="OneDrive > Empresa A > Empresa > Financeiro > 2026 > Junho"
                                >
                                  <span aria-hidden="true">&rsaquo;</span>
                                  Junho
                                </button>
                              </li>
                            </ul>
                          </li>

                          <li>
                            <button
                              type="button"
                              data-folder-path="OneDrive > Empresa A > Empresa > Financeiro > 2025"
                            >
                              <span aria-hidden="true">&rsaquo;</span>
                              2025
                            </button>
                          </li>
                        </ul>
                      </li>

                      <li>
                        <button
                          type="button"
                          data-folder-path="OneDrive > Empresa A > Empresa > Administrativo"
                        >
                          <span aria-hidden="true">&rsaquo;</span>
                          Administrativo
                        </button>
                      </li>
                    </ul>
                  </li>

                  <li>
                    <button type="button" data-folder-path="OneDrive > Empresa A > Pessoal">
                      <span aria-hidden="true">&rsaquo;</span>
                      Pessoal
                    </button>
                  </li>
                </ul>
              </li>

              <li>
                <button type="button" data-folder-path="OneDrive > Empresa B">
                  <span aria-hidden="true">&rsaquo;</span>
                  Empresa B
                </button>
              </li>
            </ul>
          </li>

          <li>
            <button type="button" data-folder-path="Uploads">
              <span aria-hidden="true">&rsaquo;</span>
              Uploads
            </button>
          </li>
        </ul>
      </li>
    </ul>
  </nav>
</aside>
