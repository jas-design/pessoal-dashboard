---
type SummaryValue = number | null;

interface Props {
  revenue?: SummaryValue;
  expenses?: SummaryValue;
  net_profit?: SummaryValue;
}

const {
  revenue = null,
  expenses = null,
  net_profit = null,
} = Astro.props;

function formatCurrency(value: SummaryValue) {
  if (value === null || !Number.isFinite(value)) {
    return "Sem dados";
  }

  return value.toLocaleString("pt-BR", {
    style: "currency",
    currency: "BRL",
    maximumFractionDigits: 0,
  });
}
---

<section
  class="monthly-financial-summary card"
  data-monthly-financial-summary
  aria-live="polite"
>
  <div class="card__header">
    <div>
      <h2>Resumo financeiro do mês</h2>
      <p>Valores canônicos publicados, sem inferir classificações ausentes.</p>
    </div>
  </div>

  <div class="monthly-financial-summary__rows">
    <div class="monthly-financial-summary__row is-positive">
      <span>Receitas</span>
      <strong data-summary-value="revenue">{formatCurrency(revenue)}</strong>
    </div>

    <div class="monthly-financial-summary__row is-expense">
      <span>(-) Despesas</span>
      <strong data-summary-value="expenses">{formatCurrency(expenses)}</strong>
    </div>

    <div class="monthly-financial-summary__row is-total">
      <span>= Lucro Líquido</span>
      <strong data-summary-value="net_profit">{formatCurrency(net_profit)}</strong>
    </div>
  </div>
</section>

<script>
  type SummaryValue = number | null;
  type SummaryData = {
    revenue: SummaryValue;
    expenses: SummaryValue;
    net_profit: SummaryValue;
  };

  function isRealNumber(value: SummaryValue): value is number {
    return typeof value === "number" && Number.isFinite(value);
  }

  function formatCurrency(value: SummaryValue) {
    if (!isRealNumber(value)) {
      return "Sem dados";
    }

    return value.toLocaleString("pt-BR", {
      style: "currency",
      currency: "BRL",
      maximumFractionDigits: 0,
    });
  }

  function updateSummary(data: SummaryData | null) {
    const values = document.querySelectorAll("[data-summary-value]");

    values.forEach((element) => {
      if (!(element instanceof HTMLElement)) {
        return;
      }

      const key = element.dataset.summaryValue as keyof SummaryData | undefined;
      element.textContent = key && data ? formatCurrency(data[key]) : "Sem dados";
    });
  }

  window.addEventListener("monthly-financial-summary-data", (event) => {
    if (event instanceof CustomEvent) {
      updateSummary(event.detail);
    }
  });
</script>
