<article class="financeiro-summary-card card" data-financeiro-monthly-summary>
  <div class="card__header">
    <div>
      <h2>Resumo do mes</h2>
      <p>Resultado consolidado do periodo selecionado.</p>
    </div>
  </div>

  <dl class="financeiro-summary-card__list">
    <div>
      <dt>Receitas</dt>
      <dd class="is-positive" data-financeiro-value="monthly_revenue">
        Carregando...
      </dd>
    </div>

    <div>
      <dt>Despesas</dt>
      <dd class="is-negative" data-financeiro-value="monthly_expenses">
        Carregando...
      </dd>
    </div>

    <div class="is-total">
      <dt>Lucro liquido</dt>
      <dd data-financeiro-value="net_profit">Carregando...</dd>
    </div>
  </dl>
</article>
