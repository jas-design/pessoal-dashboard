---
import chartIcon from "../../assets/svg/metric-chart.svg?raw";
import currencyIcon from "../../assets/svg/metric-currency.svg?raw";
import percentIcon from "../../assets/svg/metric-percent.svg?raw";
import walletIcon from "../../assets/svg/metric-wallet.svg?raw";

type MetricIcon = "chart" | "currency" | "percent" | "wallet";
type MetricTone = "positive" | "negative" | "neutral";

interface Props {
  metricKey?: string;
  title: string;
  value: string;
  icon: MetricIcon;
  accent: string;
  accentSoft: string;
  accentGlow: string;
  sparklinePath: string;
  index: number;
  variation?: string;
  tone?: MetricTone;
}

const {
  metricKey,
  title,
  value,
  icon,
  accent,
  accentSoft,
  accentGlow,
  sparklinePath,
  index,
  variation,
  tone = "neutral",
} = Astro.props;

const metricIcons: Record<MetricIcon, string> = {
  chart: chartIcon,
  currency: currencyIcon,
  percent: percentIcon,
  wallet: walletIcon,
};

const sparklineAreaPath = `${sparklinePath} L 240 72 L 0 72 Z`;
---

<article
  class="metric-card metric-card--showcase"
  data-financial-metric-card={metricKey}
  style={`--metric-accent: ${accent}; --metric-accent-soft: ${accentSoft}; --metric-accent-glow: ${accentGlow};`}
>
  <div class="metric-card__top">
    <div class="metric-card__icon" aria-hidden="true">
      <Fragment set:html={metricIcons[icon]} />
    </div>

    <div class="metric-card__copy">
      <span>{title}</span>
      <strong data-financial-metric-value>{value}</strong>
    </div>
  </div>

  {
    variation && (
      <p
        class:list={[
          "metric-card__variation",
          tone === "positive" && "is-positive",
          tone === "negative" && "is-negative",
        ]}
        data-financial-metric-variation
      >
        {variation}
      </p>
    )
  }

  {
    !variation && (
      <p class="metric-card__variation" data-financial-metric-variation hidden></p>
    )
  }

  <div class="metric-card__sparkline" aria-hidden="true">
    <svg viewBox="0 0 240 72" preserveAspectRatio="none">
      <defs>
        <linearGradient id={`financial-metric-area-${index}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--metric-accent)" stop-opacity="0.26" />
          <stop offset="100%" stop-color="var(--metric-accent)" stop-opacity="0" />
        </linearGradient>
      </defs>

        <path
          d={sparklineAreaPath}
          data-financial-metric-sparkline-area
          fill={`url(#financial-metric-area-${index})`}
        ></path>
        <path
          d={sparklinePath}
          class="metric-card__sparkline-line"
          data-financial-metric-sparkline-line
        ></path>
    </svg>
  </div>
</article>
