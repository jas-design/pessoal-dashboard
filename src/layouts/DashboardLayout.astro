---
import AuthGuard from "../components/layout/AuthGuard.astro";
import Header from "../components/layout/Header.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import BaseLayout from "./BaseLayout.astro";
import "../styles/layouts/dashboard.scss";

interface Props {
  title?: string;
  subtitle?: string;
  showFinancialPeriod?: boolean;
}

const {
  title = "Olá, Andres 👋",
  subtitle = "Aqui está o resumo das suas operações de hoje.",
  showFinancialPeriod = false,
} = Astro.props;
---

<BaseLayout title={title}>
  <AuthGuard />

  <div class="dashboard">
    <Sidebar />

    <main class="dashboard-main">
      <Header
        title={title}
        subtitle={subtitle}
        showFinancialPeriod={showFinancialPeriod}
      />

      <section class="dashboard-content">
        <slot />
      </section>
    </main>
  </div>
</BaseLayout>
