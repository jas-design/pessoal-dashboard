# Public values used by the Supabase browser client.
# These are allowed in frontend code, but RLS must protect all private data.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with PUBLIC_, import them in browser
# code, print them in logs or commit them to GitHub.
SUPABASE_SERVICE_ROLE_KEY=
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
FINANCIAL_XLSX_WORKER_SECRET=
OPENAI_API_KEY=
MICROSOFT_CLIENT_SECRET=
