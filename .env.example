# Valores públicos usados pelo cliente Supabase no navegador.
# A anon key não substitui autenticação nem políticas RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Segredos exclusivos do servidor. Nunca usar prefixo PUBLIC_,
# importar em componentes/scripts do navegador ou enviar ao Git.
SUPABASE_SERVICE_ROLE_KEY=
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
